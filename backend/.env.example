# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored. Never commit real keys.

# Google Gemini API key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_MODEL=gemini-3.5-flash

# Allowed frontend origin(s) for CORS, comma-separated
CORS_ORIGINS=http://localhost:5173

# MongoDB connection (used in the later database phase)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=formease_ai

# Encryption key for saved forms and chat history (required for saving/resuming).
# Create one with:  .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes saved forms unreadable. Keep a safe copy.
FORM_ENCRYPTION_KEY=paste_generated_key_here
